{
  "name": "@nagoloum/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "pf — le CLI de BuildIt : décrire un projet, obtenir un projet prêt à développer.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nagoloumdaniel/BuildIt",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/nagoloumdaniel/BuildIt",
  "bin": {
    "pf": "./bin/pf.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@buildit/compatibility": "workspace:*",
    "@buildit/doctor": "workspace:*",
    "@buildit/exec": "workspace:*",
    "@buildit/generator": "workspace:*",
    "@buildit/git": "workspace:*",
    "@buildit/github": "workspace:*",
    "@buildit/manifest": "workspace:*",
    "@buildit/presets": "workspace:*",
    "@buildit/registry": "workspace:*",
    "@buildit/typescript-config": "workspace:*",
    "@buildit/validation": "workspace:*",
    "@buildit/workspace": "workspace:*",
    "@vitest/coverage-v8": "5.0.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
