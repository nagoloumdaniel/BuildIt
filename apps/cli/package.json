{
  "name": "@project-factory/cli",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "pf — le CLI de Project Factory : décrire un projet, obtenir un projet prêt à développer.",
  "bin": {
    "pf": "./bin/pf.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@project-factory/compatibility": "workspace:*",
    "@project-factory/exec": "workspace:*",
    "@project-factory/generator": "workspace:*",
    "@project-factory/git": "workspace:*",
    "@project-factory/github": "workspace:*",
    "@project-factory/manifest": "workspace:*",
    "@project-factory/presets": "workspace:*",
    "@project-factory/registry": "workspace:*",
    "@project-factory/typescript-config": "workspace:*",
    "@project-factory/validation": "workspace:*",
    "@project-factory/workspace": "workspace:*",
    "@vitest/coverage-v8": "5.0.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
