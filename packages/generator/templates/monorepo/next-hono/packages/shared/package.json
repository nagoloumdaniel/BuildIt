{
  "name": "{{projectName}}-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "dev": "tsdown src/index.ts --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "tsdown": ">=0.15.0 <1.0.0",
    "typescript": ">=5.5.0 <8.0.0"
  }
}
