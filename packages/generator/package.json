{
  "name": "@buildit/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Pipeline de generation — plan de fichiers, dry-run, ecriture et rollback (§22).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@buildit/compatibility": "workspace:*",
    "@buildit/exec": "workspace:*",
    "@buildit/manifest": "workspace:*",
    "@buildit/recipes": "workspace:*",
    "@buildit/registry": "workspace:*",
    "@buildit/validation": "workspace:*",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@buildit/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "5.0.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@types/semver": "7.8.0"
  }
}
